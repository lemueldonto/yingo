# ─────────────────────────────────────────────
# Yingo — .gitignore (monorepo: Expo app, engine package, Supabase)
# ─────────────────────────────────────────────

# ── Secrets & environment ────────────────────
# Never commit real keys. Commit a .env.example with empty values instead.
.env
.env.*
!.env.example
*.local

# Signing keys & store credentials
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.cer
credentials.json
service-account*.json

# ── Dependencies ─────────────────────────────
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ── Expo / React Native ──────────────────────
.expo/
.expo-shared/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Native folders are generated by `expo prebuild` (Continuous Native Generation).
# Remove these two lines if you ever decide to edit native code by hand.
apps/mobile/ios/
apps/mobile/android/

# Local EAS builds
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip
build-*.tar.gz

# ── Build output ─────────────────────────────
dist/
build/
out/
.turbo/

# ── Tests & coverage ─────────────────────────
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/

# ── Supabase (local dev) ─────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/functions/.env

# ── Logs & debug ─────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ─────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Editors & IDEs ───────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~
