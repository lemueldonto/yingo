# Normalize line endings: LF in the repository, whatever the OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.glb binary
*.gltf binary
*.riv binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
